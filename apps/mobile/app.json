{
  "expo": {
    "name": "Scrapbook/01",
    "slug": "scrapbook01",
    "scheme": "scrapbook01",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "bundleIdentifier": "com.scrapbook01.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.scrapbook01.app",
      "adaptiveIcon": {
        "backgroundColor": "#F3F4F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "lang": "es-UY",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-share-extension",
        {
          "activationRules": [
            {
              "type": "url",
              "max": 1
            },
            {
              "type": "text"
            }
          ],
          "excludedPackages": [
            "expo-dev-client",
            "expo-splash-screen",
            "expo-updates",
            "expo-font",
            "expo-router",
            "expo-web-browser",
            "expo-notifications",
            "expo-device"
          ],
          "backgroundColor": {
            "red": 243,
            "green": 244,
            "blue": 246,
            "alpha": 1
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "Scrapbook01ShareExtension",
                  "bundleIdentifier": "com.scrapbook01.app.ShareExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.scrapbook01.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "24c9cb87-753f-4682-b4f5-282fae954d99"
      },
      "appleApplicationGroup": "group.com.scrapbook01.app"
    },
    "owner": "franco-roura",
    "updates": {
      "url": "https://u.expo.dev/24c9cb87-753f-4682-b4f5-282fae954d99"
    }
  }
}
