# Go API (server/). On a phone, use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8080
# WorkOS client id (Dashboard -> API Keys). It's public; no secret goes in the app.
EXPO_PUBLIC_WORKOS_CLIENT_ID=client_
# Optional: your custom auth domain instead of the WorkOS API.
# EXPO_PUBLIC_WORKOS_API_URL=https://api.workos.com
