# Go API (server/). On a phone, use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8080
# WorkOS client id (Dashboard -> API Keys). It's public; no secret goes in the app.
EXPO_PUBLIC_WORKOS_CLIENT_ID=client_
# Optional: your custom auth domain instead of the WorkOS API.
# EXPO_PUBLIC_WORKOS_API_URL=https://api.workos.com

# Optional: Sentry error and performance reporting. Leave the DSN empty (the
# default) and Sentry never starts and nothing is sent.
# EXPO_PUBLIC_SENTRY_DSN=
# Share of navigations and saves traced, 0 to 1 (default 1).
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1
# "true" logs what the SDK does, to check a setup.
# EXPO_PUBLIC_SENTRY_DEBUG=false
#
# EAS builds upload source maps and dSYMs to Sentry: eas.json sets
# SENTRY_DISABLE_AUTO_UPLOAD=false, SENTRY_ORG and SENTRY_PROJECT, and the token
# is an EAS secret:
#   bun x eas-cli env:create --name SENTRY_AUTH_TOKEN --visibility secret --environment production
# Self-hosting without Sentry (or without a token)? Set
# "SENTRY_DISABLE_AUTO_UPLOAD": "true" in eas.json, or EAS builds fail.
# Local Release builds (expo run:ios --configuration Release) without a token
# need SENTRY_DISABLE_AUTO_UPLOAD=true in the shell, or the Xcode step fails.
# Never put the auth token in app.json or in an EXPO_PUBLIC_ variable.
