ADDR=:8080
DATABASE_URL=postgres://scrapbook:scrapbook@localhost:54329/scrapbook?sslmode=disable
MIGRATE_ON_START=true

# WorkOS AuthKit. The client id is on the dashboard's API Keys page; the
# AuthKit domain is under Domains (https://<something>.authkit.app).
# App tokens are checked against <WORKOS_API_URL>/sso/jwks/<WORKOS_CLIENT_ID>,
# MCP tokens against <WORKOS_AUTHKIT_DOMAIN>/oauth2/jwks.
WORKOS_CLIENT_ID=client_
WORKOS_AUTHKIT_DOMAIN=https://your-subdomain.authkit.app
# Optional: your custom auth domain instead of the WorkOS API.
# WORKOS_API_URL=https://api.workos.com
# Optional: the exact "iss" of the app's tokens, to check it too. Unset, the
# per-client signing keys are the check (as in WorkOS's own SDKs).
# WORKOS_ISSUER=
# Local development only: also accept HS256 tokens with issuer
# "scrapbook01-dev" signed with this secret (WorkOS becomes optional).
DEV_JWT_SECRET=

# Comma-separated browser origins allowed to call the API (web builds only).
CORS_ORIGINS=http://localhost:8081

# The API's public origin. MCP clients find the OAuth setup through
# <PUBLIC_URL>/.well-known/oauth-protected-resource/mcp.
PUBLIC_URL=http://localhost:8080

# Background jobs (classification) run in this process.
RUN_WORKERS=true

# Jev (TypeSafe) matches items to the user's existing categories.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_THRESHOLD=0.6

# Embeddings: OpenAI-compatible endpoint, must return 1536 dimensions.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
EMBEDDINGS_MODEL=openai/text-embedding-3-small
# Cosine similarity two items need to be linked in the graph. 0.45 suits
# text-embedding-3-small; other models (and cmd/fakeai) need their own value.
GRAPH_MIN_SIMILARITY=0.45

# Claude Haiku names new categories when nothing existing fits.
ANTHROPIC_API_KEY=
CATEGORY_NAMER_MODEL=claude-haiku-5-5

# Credits: free model budget for each new user, in dollars, and list prices
# (dollars per million tokens) used to meter each call.
STARTER_CREDITS_USD=0.10
JEV_PRICE_PER_MTOK=0.042
EMBEDDINGS_PRICE_PER_MTOK=0.02
NAMER_INPUT_PRICE_PER_MTOK=0.10
NAMER_OUTPUT_PRICE_PER_MTOK=0.50

# Optional: only if push security is on in the Expo project.
EXPO_ACCESS_TOKEN=
