ADDR=:8080
DATABASE_URL=postgres://scrapbook:scrapbook@localhost:54329/scrapbook?sslmode=disable
MIGRATE_ON_START=true

# Supabase project URL. Tokens are checked against its JWKS
# (<SUPABASE_URL>/auth/v1/.well-known/jwks.json) and issuer (<SUPABASE_URL>/auth/v1).
SUPABASE_URL=https://your-project.supabase.co
# Optional: legacy HS256 secret. When set, it is used instead of the JWKS.
SUPABASE_JWT_SECRET=

# Comma-separated browser origins allowed to call the API (web builds only).
CORS_ORIGINS=http://localhost:8081
